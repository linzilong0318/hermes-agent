#!/command/with-contenv sh
# shellcheck shell=sh
# Nacos service registration and heartbeat daemon.
#
# Runs as a supervised longrun service under s6-overlay.
# When NACOS_SERVER_ADDRESSES is unset (or empty), exits cleanly and the
# companion finish script returns 125 — s6-supervise marks the slot as
# permanently down and never restarts it.  See docker/s6-rc.d/nacos-registrar/finish.
#
# Environment variables consumed by nacos_daemon.py:
#   NACOS_SERVER_ADDRESSES, NACOS_NAMESPACE, NACOS_GROUP_NAME,
#   NACOS_SERVICE_NAME, NACOS_SERVICE_PORT, NACOS_USERNAME, NACOS_PASSWORD

if [ -z "${NACOS_SERVER_ADDRESSES:-}" ]; then
    exit 0
fi

# with-contenv repopulates HOME from /init as /root by default; reset it
# so HOME-anchored state lands under /opt/data.
export HOME=/opt/data

cd /opt/data || exit 1
# shellcheck disable=SC1091
. /opt/hermes/.venv/bin/activate

# Skip the drop when already non-root. Do NOT build the exec'd command by
# appending "$@" — s6-rc invokes longrun run scripts with the service name
# as $1 (see e.g. logutil-service-main in the s6-overlay package), so the
# previous "set -- s6-setuidgid hermes \"$@\"" pattern tacked the literal
# string "nacos-registrar" onto the command line. s6-setuidgid then tried
# to exec a program named "nacos-registrar" and failed with "unable to
# exec nacos-registrar: No such file or directory" on every restart.
[ "$(id -u)" = 0 ] || exec python /opt/hermes/docker/nacos_daemon.py
exec s6-setuidgid hermes python /opt/hermes/docker/nacos_daemon.py